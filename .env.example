# ==============================================================================
# Fruity Fusion Bar - Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose secret keys in client-side code!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Server-Side Only)
# Found in Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase Service Role Secret Key (Allows server-side RPC & secure queries)
# CRITICAL: DO NOT prefix with NEXT_PUBLIC_! This key must remain secret on the server.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Staff Admin Portal Authentication
# ------------------------------------------------------------------------------
# Master shared password used by stall staff to log in at /admin/login
ADMIN_PASSWORD=

# Cryptographic secret used to sign session JWTs (minimum 32 characters recommended)
SESSION_SECRET=

# Secret key used to generate and verify 30-second rolling staff codes (TOTP HMAC-SHA256)
STAFF_TOTP_SECRET=

# ------------------------------------------------------------------------------
# Loyalty Rules (Optional)
# ------------------------------------------------------------------------------
# Number of eligible drink purchases required to earn one free drink.
# Default: 3 (can be changed to 5 or any integer)
STAMPS_REQUIRED=3
